# Copy these entries into the existing private .env file; preserve its secrets.
# Never use VITE_ for an API key: those values are exposed to the browser.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-terra
# auto selects OpenAI when a key exists, otherwise local contrast detection.
# openai requires a key and surfaces an error if it is missing or rejected.
DAMAGE_ANALYSIS_PROVIDER=auto

# Creative garment edits and matching stitch paths. auto enables when the key is set.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
REPAIR_PREVIEW_PROVIDER=auto

GENERATION_USER_DAILY_LIMIT=12
GENERATION_GLOBAL_DAILY_LIMIT=300
# Deploy separate pools with analyze / compile / preview, or all three locally.
WORKER_JOB_KINDS=analyze,compile,preview

# Public Firebase web app configuration (these are not service-account credentials).
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=
# Enable after creating Firestore and configuring server ADC credentials.
FIRESTORE_ENABLED=false
# Local only: point to an ignored service-account file, never a VITE_ variable.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/.secrets/firebase-admin.json
FIREBASE_EMULATORS_ALLOWED=false
