# Copy these entries into the existing private .env file; preserve its secrets.
# Never use VITE_ for an API key: those values are exposed to the browser.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-terra
# auto selects OpenAI when a key exists, otherwise local contrast detection.
# openai requires a key and surfaces an error if it is missing or rejected.
DAMAGE_ANALYSIS_PROVIDER=auto
