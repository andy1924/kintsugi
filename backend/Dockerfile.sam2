FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SAM2_BUILD_CUDA=0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir setuptools wheel
COPY backend/requirements-ml.txt ./requirements-ml.txt
RUN pip install --no-cache-dir --no-build-isolation -r requirements-ml.txt
RUN useradd --uid 10001 --create-home kintsugi && mkdir /data && chown kintsugi /data
COPY --chown=kintsugi backend/ /app/
USER kintsugi
ENV DATA_DIR=/data SEGMENTATION_MODEL=sam2 SAM2_CHECKPOINT=/models/sam2.1_hiera_tiny.pt
CMD ["python", "-m", "kintsugi.worker"]
